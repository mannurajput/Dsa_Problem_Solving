# nput: [123, 456, 789]  
# Output: [6, 15, 24]
# Explanation:  123 = 1 + 2 + 3 = 6  
#                         456 = 4 + 5 + 6 = 15  
#                         789 = 7 + 8 + 9 = 24  
input= [123, 456, 789]
addedValue=[]
for item in input:
    num=0
    while item>0:
        num+=item%10
        item //= 10
    addedValue.append(num)
print(addedValue)
