class Node:

    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

root = Node(1)
root.left = Node(2)
root.right = Node(3)

def inorder(node):

    if not node:
        return

    inorder(node.left)
    print(node.data)
    inorder(node.right)

inorder(root)
