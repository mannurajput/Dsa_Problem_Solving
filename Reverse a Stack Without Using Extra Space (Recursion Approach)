def insert_at_bottom(stack, item):
    if not stack:
        stack.append(item)
        return
    
    temp = stack.pop()
    insert_at_bottom(stack, item)
    stack.append(temp)


def reverse_stack(stack):
    if not stack:
        return
    
    temp = stack.pop()
    reverse_stack(stack)
    insert_at_bottom(stack, temp)


# Example
stack = [1, 2, 3, 4]
reverse_stack(stack)
print(stack)   # Output: [4, 3, 2, 1]
